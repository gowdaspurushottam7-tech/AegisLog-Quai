# Isolated Vault Encrypted Batches and runtime files (keep folder via .gitkeep)
vault/*.enc
vault/.agent_killed
vault/.heartbeat
vault/.agent_state.json
vault/*.meta.json
vault/vault.key
!vault/.gitkeep

# Editor & OS files
.DS_Store
Thumbs.db
.vscode/
.idea/
