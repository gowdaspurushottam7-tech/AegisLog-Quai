# Dependencies
node_modules/
*/node_modules/

# Production build artifacts
dist/
frontend/dist/

# Hardhat build cache & artifacts
contracts/cache/
contracts/artifacts/

# Python cache & virtual environments
__pycache__/
*/__pycache__/
*.pyc
.venv/
*/.venv/
env/
